# MarketLab settings. Copy this file to `.env` (cp .env.example .env) and fill in what you want.
# `.env` is private (git ignores it). Every setting is optional: features without a key switch themselves off.
# After editing, restart MarketLab (Ctrl+C, then python3 marketlab.py).

# 1) Claude API key (enables clean company summaries + Ask MarketLab).
#    Get one at https://console.anthropic.com -> API Keys. Usage is billed per request.
ANTHROPIC_API_KEY=

# 1b) Or use your Claude subscription for Ask MarketLab instead of an API key (personal use).
#    Install Claude Code (https://code.claude.com/docs/en/setup), then run `claude auth login`
#    in Terminal once. MarketLab finds it automatically; nothing goes in this file.
# AI_PROVIDER=auto            # auto | claude_code | anthropic_api
# CLAUDE_CODE_MODEL=sonnet    # sonnet | opus | haiku

# 2) SEC EDGAR identification (enables official filings + SEC financial data). Free.
#    The SEC requires a name and contact email, e.g.:  SEC_USER_AGENT=Jane Smith jane@example.com
SEC_USER_AGENT=

# Optional: which Claude models to use (defaults shown).
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# AI_MODEL_ASSISTANT=claude-sonnet-5-5

# 3) Optional news providers. MarketLab already uses several free sources without keys
#    (SEC filings, company newsrooms, Bing/Google News, Nasdaq, Federal Register...).
#    Each key below adds another independent source. All have free tiers.
# FINNHUB_API_KEY=        # https://finnhub.io/register  (company news with original links)
# ALPHAVANTAGE_API_KEY=   # https://www.alphavantage.co/support/#api-key  (25 requests/day)
# POLYGON_API_KEY=        # https://polygon.io  (ticker news, 5 requests/min)
